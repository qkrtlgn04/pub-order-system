rules_version = '2';

// 주점 주문 시스템 보안 규칙 v7 (주문 + 테이블·예약 + 웨이팅 + 전화번호)

service cloud.firestore {
  match /databases/{database}/documents {

    // 메뉴(+사진): 누구나 읽기, 주방 화면만 수정
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 주문
    match /orders/{orderId} {
      allow read: if true;

      // 손님: 정해진 형식의 "새 주문"만 넣을 수 있음
      allow create: if request.auth != null || isValidNewOrder(request.resource.data);

      // 상태 변경 / 전체 초기화는 주방 화면만
      allow update, delete: if request.auth != null;
    }

    // 테이블 사용 현황: 누구나 읽기, 주방 화면만 수정
    match /tables/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 예약(예약자 이름 등): 주방 화면만 읽기/쓰기
    match /reservations/{resId} {
      allow read, write: if request.auth != null;
    }

    // 웨이팅: 누구나 읽기(대기 순서 확인), 손님은 등록과 "본인 취소"만 가능
    match /waitlist/{waitId} {
      allow read: if true;
      allow create: if request.auth != null || isValidWait(request.resource.data);
      // 손님: 본인 웨이팅 취소, 호출 알림 확인 / "지금 갈게요" 응답
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['waiting', 'called'])
        || (resource.data.status == 'called'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'ackAt'])
            && request.resource.data.get('seenAt', request.time) is timestamp
            && request.resource.data.get('ackAt', request.time) is timestamp);
      allow delete: if request.auth != null;
    }

    // 웨이팅 전화번호: 손님은 등록만, 읽기/삭제는 주방 화면만
    match /waitPhones/{waitId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth != null
        || (request.resource.data.keys().hasOnly(['phone', 'createdAt'])
            && request.resource.data.phone is string
            && request.resource.data.phone.matches('^01[0-9]{8,9}$')
            && request.resource.data.createdAt == request.time
            && existsAfter(/databases/$(database)/documents/waitlist/$(waitId)));
    }

    // 웨이팅 번호 카운터: 손님은 "1 올리기"만 가능
    match /settings/waitCounter {
      allow create: if request.resource.data.keys().hasOnly(['nextWaitNumber'])
                    && request.resource.data.nextWaitNumber == 2;
      allow update: if request.resource.data.keys().hasOnly(['nextWaitNumber'])
                    && request.resource.data.nextWaitNumber == resource.data.nextWaitNumber + 1;
    }

    // 설정(상점명/계좌/PIN): 누구나 읽기, 주방 화면만 수정
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 주문번호 카운터: 손님은 "1 올리기"만 가능
    match /settings/counter {
      allow create: if request.resource.data.keys().hasOnly(['nextOrderNumber'])
                    && request.resource.data.nextOrderNumber == 2;
      allow update: if request.resource.data.keys().hasOnly(['nextOrderNumber'])
                    && request.resource.data.nextOrderNumber == resource.data.nextOrderNumber + 1;
    }

    function isValidWait(d) {
      return d.keys().hasOnly(['waitNumber', 'name', 'people', 'status', 'createdAt'])
        && d.status == 'waiting'
        && d.waitNumber is int && d.waitNumber > 0
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.people is int && d.people > 0 && d.people <= 20
        && d.createdAt == request.time;
    }

    function isValidNewOrder(d) {
      return d.keys().hasOnly(['orderNumber', 'tableNo', 'items', 'totalAmount', 'depositorName', 'note', 'status', 'createdAt'])
        && (!('tableNo' in d) || (d.tableNo is int && d.tableNo > 0 && d.tableNo < 100))
        && d.status == 'awaiting_payment'
        && d.orderNumber is int && d.orderNumber > 0
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30
        && d.totalAmount is int && d.totalAmount >= 0
        && d.depositorName is string && d.depositorName.size() > 0 && d.depositorName.size() <= 30
        && d.note is string && d.note.size() <= 60
        && d.createdAt == request.time;
    }
  }
}
